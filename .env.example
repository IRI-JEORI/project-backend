# Copy this file to a protected server path such as /etc/nunnun/nunnun.env.
# Never commit the populated file. systemd EnvironmentFile syntax is used.

# Required database settings
DB_URL=jdbc:mysql://127.0.0.1:3306/nunnun?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=<YOUR_DB_USERNAME>
DB_PASSWORD=<YOUR_DB_PASSWORD>

# Required JWT settings
JWT_SECRET=<YOUR_LONG_RANDOM_JWT_SECRET>
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=1209600000

# OpenAI
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL=gpt-5
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30

# AWS S3. Prefer an EC2 IAM role instead of static credentials.
AWS_S3_ENABLED=true
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=nunnun-wake-storage-608841098309-ap-northeast-2-an
# If an IAM role cannot be used, provide standard AWS SDK variables only in
# the protected runtime environment (do not commit them):
# AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
# AWS_SESSION_TOKEN=<YOUR_AWS_SESSION_TOKEN_IF_REQUIRED>

# Firebase Admin SDK (Google Application Default Credentials)
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=<YOUR_FIREBASE_PROJECT_ID>
GOOGLE_APPLICATION_CREDENTIALS=/etc/nunnun/firebase-admin.json

# Background job timing (milliseconds; current application defaults shown)
WAKE_PROOF_CLEANUP_FIXED_DELAY_MS=300000
WAKE_PROOF_ORPHAN_CLEANUP_FIXED_DELAY_MS=3600000
WAKE_PROOF_ORPHAN_GRACE_PERIOD_MS=3600000
NOTIFICATION_DISPATCHER_FIXED_DELAY_MS=30000
NOTIFICATION_DISPATCHER_INITIAL_DELAY_MS=30000
